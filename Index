    </section>

    <!-- 7. GALLERY SECTION -->
    <section id="gallery">
        <h2>Captured Moments</h2>
        <div class="swiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide"><img src="wedding (1).jpeg" alt="Moment 1"></div>
                <div class="swiper-slide"><img src="wedding (2).jpeg" alt="Moment 2"></div>
                <div class="swiper-slide"><img src="wedding (3).jpeg" alt="Moment 3"></div>
                <div class="swiper-slide"><img src="wedding (4).jpeg" alt="Moment 4"></div>
                <div class="swiper-slide"><img src="wedding (5).jpeg" alt="Moment 5"></div>
                <div class="swiper-slide"><img src="wedding (6).jpeg" alt="Moment 6"></div>
                <div class="swiper-slide"><img src="wedding (7).jpeg" alt="Moment 7"></div>
                <div class="swiper-slide"><img src="wedding (8).jpeg" alt="Moment 8"></div>
                <div class="swiper-slide"><img src="wedding (9).jpeg" alt="Moment 9"></div>
                <div class="swiper-slide"><img src="wedding (10).jpeg" alt="Moment 10"></div>
                <div class="swiper-slide"><img src="wedding (11).jpeg" alt="Moment 11"></div>
                <div class="swiper-slide"><img src="wedding (12).jpeg" alt="Moment 12"></div>
                <div class="swiper-slide"><img src="wedding (13).jpeg" alt="Moment 13"></div>
                <div class="swiper-slide"><img src="wedding (14).jpeg" alt="Moment 14"></div>
                <div class="swiper-slide"><img src="wedding (15).jpeg" alt="Moment 15"></div>
                <div class="swiper-slide"><img src="wedding (16).jpeg" alt="Moment 16"></div>
                <div class="swiper-slide"><img src="wedding (17).jpeg" alt="Moment 17"></div>
