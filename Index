            </div>
            <div class="time-box">
                <span id="minutes">00</span>
                <p>Mins</p>
            </div>
            <div class="time-box second-box">
                <span id="seconds">00</span>
                <p>Secs</p>
            </div>
        </div>
    </section>

    <!-- 5. LOCATION DETAILS SECTION -->
    <section id="location-details">
        <div class="details-container">
            <a href="https://maps.app.goo.gl/VaBfb3qn3Z6wrkBS7" target="_blank" class="location-card-link">
                <div class="location-card">
