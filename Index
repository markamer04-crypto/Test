<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Wedding Day</title>
    
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap">
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        :root {
            --primary-gold: #d4af37;
            --soft-white: #fcfaf7;
            --text-dark: #2c2c2c;
            --overlay: rgba(0, 0, 0, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            font-family: 'Lato', sans-serif;
            color: var(--text-dark);
            background-color: var(--soft-white);
            scroll-behavior: smooth;
            overflow-x: hidden;
            width: 100%;
            height: 100%;
        }

        /* Lock scrolling while rope overlay is active */
        body.rope-locked {
            overflow: hidden !important;
        }

        /* --- HEART ROPE OVERLAY STYLES --- */
        #rope-canvas {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            display: block !important;
            z-index: 99999 !important;
            background-color: #111111 !important;
            cursor: grab;
            touch-action: none;
            transition: opacity 0.8s ease-out;
        }

        #rope-canvas:active {
            cursor: grabbing;
        }

        #rope-canvas.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .rope-instruction {
            position: fixed;
            top: 12%;
            width: 100%;
            text-align: center;
            color: #ffffff;
            font-size: 1.4rem;
            font-family: 'Playfair Display', serif;
            letter-spacing: 1px;
            z-index: 100000;
            pointer-events: none;
            transition: opacity 0.5s;
        }

        /* --- Hero Section --- */
        .hero {
            height: 100vh;
            width: 100%;
            background: linear-gradient(135deg, #0d0d1a 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
            padding: 0 20px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 8vw, 5rem);
            margin-bottom: 0.5rem;
            font-style: italic;
            animation: fadeInDown 1.5s ease-out forwards;
            letter-spacing: 3px;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .hero .subtitle {
            font-size: clamp(1rem, 3vw, 1.5rem);
            font-family: 'Playfair Display', serif;
            margin-bottom: 2rem;
            animation: fadeIn 2s ease-in forwards;
            font-weight: 300;
        }

        .hero p {
            font-size: clamp(0.8rem, 2vw, 1.1rem);
            letter-spacing: 4px;
            text-transform: uppercase;
            animation: fadeInUp 2s ease-out forwards;
            border-top: 1px solid rgba(212, 175, 55, 0.6);
            border-bottom: 1px solid rgba(212, 175, 55, 0.6);
            padding: 15px 25px;
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
        }

        .scroll-indicator span {
            display: block;
            width: 2px;
            height: 25px;
            background: rgba(255, 255, 255, 0.7);
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(10px); }
        }

        /* --- Floating Petals Container --- */
        #petal-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9998;
        }

        .petal {
            position: absolute;
            background-color: #ffe4e1;
            border-radius: 150% 0 150% 0;
            opacity: 0;
            animation: float 12s linear forwards;
        }

        @keyframes float {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.7; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }

        /* --- Sections --- */
        section {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 2.8rem);
            color: var(--primary-gold);
            margin-bottom: 40px;
            letter-spacing: 2px;
        }

        h2::after {
            content: '';
            display: block;
            width: 50px;
            height: 2px;
            background: var(--primary-gold);
            margin: 20px auto 0;
        }

        /* --- Countdown --- */
        #countdown {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 30px;
        }

        .time-box {
            background: white;
            padding: 25px 15px;
            border-radius: 15px;
            min-width: 90px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.3);
            transition: transform 0.3s ease;
        }

        .time-box:hover {
            transform: translateY(-5px);
            border-color: var(--primary-gold);
        }

        .time-box span {
            display: block;
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: bold;
            color: var(--primary-gold);
        }

        .time-box p {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 5px;
            color: var(--text-dark);
        }

        .second-box {
            background: var(--soft-white);
            border: 1px dashed var(--primary-gold);
        }

        .second-box span {
            animation: pulse 1s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.7; }
            100% { opacity: 1; }
        }

        /* --- Location Cards --- */
        #location-details {
            background-color: var(--soft-white);
            padding: 40px 20px;
        }

        .details-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            max-width: 1000px;
            margin: 0 auto;
        }

        .location-card-link {
            text-decoration: none;
            color: inherit;
            flex: 1;
            min-width: 280px;
            display: flex;
        }

        .location-card {
            width: 100%;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border-bottom: 4px solid var(--primary-gold);
            transition: all 0.3s ease;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .location-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.2);
        }

        .location-card .icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .location-card h3 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-gold);
            margin-bottom: 10px;
            font-size: 1.6rem;
        }

        .location-card p {
            font-size: 1.1rem;
            line-height: 1.6;
            color: var(--text-dark);
        }

        .location-card .time {
            margin-top: 15px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-size: 0.9rem;
            color: #888;
        }

        .map-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 8px 15px;
            background-color: var(--soft-white);
            color: var(--primary-gold);
            border: 1px solid var(--primary-gold);
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
            transition: 0.3s;
        }

        .location-card:hover .map-btn {
            background-color: var(--primary-gold);
            color: white;
        }

        /* --- Mini Moment Section --- */
        #special-note {
            padding: 20px 0;
            display: flex;
            justify-content: center;
            background-color: transparent;
        }

        .mini-moment-container {
            width: 80%; 
            max-width: 350px; 
            margin: 0 auto;
        }

        .mini-moment-box img {
            width: 100%;
            aspect-ratio: 3 / 4; 
            object-fit: cover;
            display: block;
            border-radius: 12px;
        }

        .mini-moment-label {
            padding: 15px;
            font-family: 'Playfair Display', serif;
            font-size: clamp(0.9rem, 2vw, 1.1rem); 
            line-height: 1.4;
            color: var(--text-dark);
            background: white;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        /* --- Gallery Section --- */
        #gallery {
            background: #f9f7f4;
            width: 100%;
        }

        .swiper-slide {
            background-position: center;
            background-size: cover;
            width: 300px;
            height: 400px;
        }

        .swiper-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        /* --- RSVP Form --- */
        .rsvp-form {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
            max-width: 550px;
            margin: 40px auto 0;
            border-top: 5px solid var(--primary-gold);
        }

        input, select {
            width: 100%;
            padding: 16px;
            margin: 12px 0;
            border: 1px solid #e1e1e1;
            border-radius: 8px;
            font-family: 'Lato', sans-serif;
            font-size: 1rem;
            transition: border-color 0.3s;
            outline: none;
        }

        input:focus, select:focus {
            border-color: var(--primary-gold);
        }

        button {
            width: 100%;
            padding: 18px;
            margin-top: 20px;
            background: var(--text-dark);
            color: white;
            border: none;
            border-radius: 8px;
            font-family: 'Lato', sans-serif;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s;
        }

        button:hover {
            background: var(--primary-gold);
            color: white;
        }

        /* --- Footer --- */
        footer {
            background: var(--text-dark);
            color: white;
            text-align: center;
            padding: 40px 20px;
            font-size: 1rem;
        }

        /* --- Animations --- */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes fadeInDown { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

        /* --- Responsive --- */
        @media (max-width: 768px) {
            section { padding: 60px 20px; }
            .details-container { flex-direction: column; align-items: center; }
            .location-card { width: 100%; }
        }

        @media (max-width: 480px) {
            h2 { font-size: 2rem; }
            .rsvp-form { padding: 30px 20px; }
        }
    </style>
</head>
<body class="rope-locked">

    <!-- 1. HEART ROPE OVERLAY (Placed at top of body) -->
    <div id="rope-instruction" class="rope-instruction">Pull the heart rope outward to untie it!</div>
    <canvas id="rope-canvas"></canvas>

    <!-- 2. FLOATING PETALS CONTAINER -->
    <div id="petal-container"></div>

    <!-- 3. HERO SECTION -->
    <header class="hero">    
        <h1>Our Story</h1>
        <div class="subtitle">Join us in celebrating our journey</div>
        <p>Save the Date</p>
        <div class="scroll-indicator"><span></span></div>
    </header>

    <!-- 4. COUNTDOWN SECTION -->
    <section id="countdown-section">
        <h2>Days until the Wedding</h2>
        <div id="countdown">
            <div class="time-box">
                <span id="days">00</span>
                <p>Days</p>
            </div>
            <div class="time-box">
                <span id="hours">00</span>
