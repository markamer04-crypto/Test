    <!-- 6. MINI MOMENT SECTION -->
    <section id="special-note">
        <div class="mini-moment-container">
            <div class="mini-moment-box">
                <img src="wedding (18).jpeg" alt="Food and Fun">
                <div class="mini-moment-label">Food? No worries we got you covered 😉</div>
            </div>
