    <!-- RSVP SECTION -->
    <section id="rsvp">
        <h2>Will You Join Us?</h2>
        <form class="rsvp-form" id="rsvpForm">
            <input type="text" id="name" placeholder="Full Name" required>
            <input type="email" placeholder="Email Address" required>
            <select id="attendance">
                <option value="yes">Yes, I'll be there!</option>
                <option value="no">Sadly, I can't make it</option>
            </select>
            <button type="submit">Send RSVP</button>
        </form>
    </section>

    <footer>
        <p>Created with Love &copy; 2026</p>
    </footer>

    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- ALL JAVASCRIPT -->
    <script>
        window.addEventListener('load', () => {
            // --- 1. DOWNWARD PULL ROPE PHYSICS LOGIC ---
            const canvas = document.getElementById('pull-canvas');
            const overlay = document.getElementById('rope-overlay');
            if (canvas && overlay) {
                const ctx = canvas.getContext('2d');
                let width, height;
                let isDragging = false;

                // Physics points for the hanging rope
                let points = [];
                const numPoints = 25;
                const ropeLength = 350; // Base length in px
                let currentPullY = 0;
                const pullThreshold = 220; // How many px user pulls down to release

                function resize() {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                    initRope();
                }

                function initRope() {
                    points = [];
                    const startX = width / 2;
                    const segmentLen = ropeLength / numPoints;

                    for (let i = 0; i <= numPoints; i++) {
                        points.push({
                            x: startX,
                            y: i * segmentLen,
                            ox: startX,
                            oy: i * segmentLen,
                            vx: 0,
                            vy: 0
                        });
                    }
                }

                function getPointer(e) {
                    const rect = canvas.getBoundingClientRect();
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    return { x: clientX - rect.left, y: clientY - rect.top };
                }

                function onStart(e) {
                    const pos = getPointer(e);
                    const handle = points[points.length - 1];
                    // Check if click/tap is near the bottom handle ring
                    const dist = Math.hypot(pos.x - handle.x, pos.y - handle.y);
                    if (dist < 80) {
                        isDragging = true;
                    }
                }

                function onMove(e) {
                    if (!isDragging) return;
                    const pos = getPointer(e);
                    const handle = points[points.length - 1];

                    handle.x = pos.x;
                    handle.y = Math.max(pos.y, ropeLength); // Only allow pulling downward

                    currentPullY = handle.y - ropeLength;

                    // Trigger reveal when pulled down past threshold
                    if (currentPullY > pullThreshold) {
                        revealWebsite();
                    }
                }

                function onEnd() {
                    isDragging = false;
                    currentPullY = 0;
                }

                function updateRope() {
                    const stiffness = 0.15;
                    const damping = 0.75;
                    const startX = width / 2;

                    // Anchor the top of the rope to top-center of page
                    points[0].x = startX;
                    points[0].y = 0;

                    for (let i = 1; i < points.length; i++) {
                        const p = points[i];
                        if (i === points.length - 1 && isDragging) continue;

                        // Spring back to resting vertical line
                        const targetX = startX;
                        const targetY = (i / numPoints) * ropeLength;

                        p.vx = (p.vx + (targetX - p.x) * stiffness) * damping;
                        p.vy = (p.vy + (targetY - p.y) * stiffness) * damping;

                        p.x += p.vx;
                        p.y += p.vy;
                    }
                }

                function drawRope() {
                    ctx.clearRect(0, 0, width, height);

                    // Draw Rope Body
                    ctx.beginPath();
                    ctx.moveTo(points[0].x, points[0].y);
                    for (let i = 1; i < points.length; i++) {
                        ctx.lineTo(points[i].x, points[i].y);
                    }
                    ctx.lineWidth = 14;
                    ctx.strokeStyle = '#d4af37'; // Gold rope
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';
                    ctx.stroke();

                    // Inner Highlight Thread
                    ctx.lineWidth = 4;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();

                    // Draw Handle Ring/Knob at bottom end
                    const handle = points[points.length - 1];
                    ctx.beginPath();
                    ctx.arc(handle.x, handle.y, 22, 0, Math.PI * 2);
                    ctx.fillStyle = '#d4af37';
                    ctx.fill();
                    ctx.lineWidth = 4;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();

                    // Inner decorative core of handle
                    ctx.beginPath();
                    ctx.arc(handle.x, handle.y, 8, 0, Math.PI * 2);
                    ctx.fillStyle = '#ffffff';
                    ctx.fill();
                }

                function animate() {
                    updateRope();
                    drawRope();
                    requestAnimationFrame(animate);
                }

                function revealWebsite() {
                    isDragging = false;
                    overlay.classList.add('revealed');
                    document.body.classList.remove('rope-locked');
                }

                window.addEventListener('resize', resize);
                canvas.addEventListener('mousedown', onStart);
                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onEnd);

                canvas.addEventListener('touchstart', onStart);
                window.addEventListener('touchmove', onMove);
                window.addEventListener('touchend', onEnd);

                resize();
                animate();
            }

            // --- 2. COUNTDOWN LOGIC ---
            const weddingDate = new Date("April 16, 2026 15:00:00").getTime();
            setInterval(function() {
                const now = new Date().getTime();
                const distance = weddingDate - now;

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                if (document.getElementById("days")) {
                    document.getElementById("days").innerText = days.toString().padStart(2, '0');
                    document.getElementById("hours").innerText = hours.toString().padStart(2, '0');
                    document.getElementById("minutes").innerText = minutes.toString().padStart(2, '0');
                    document.getElementById("seconds").innerText = seconds.toString().padStart(2, '0');
                }
            }, 1000);

            // --- 3. SWIPER SLIDER LOGIC ---
            new Swiper('.swiper', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 50,
                    stretch: 0,
                    depth: 100,
                    modifier: 1,
                    slideShadows: true,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
            });

            // --- 4. FLOATING PETALS LOGIC ---
            function createPetal() {
                const container = document.getElementById('petal-container');
                if (!container) return;
                const petal = document.createElement('div');
                petal.className = 'petal';
                petal.style.left = Math.random() * 100 + 'vw';
                petal.style.width = Math.random() * 15 + 10 + 'px';
                petal.style.height = petal.style.width;
                petal.style.animationDuration = Math.random() * 5 + 7 + 's';
                container.appendChild(petal);
                setTimeout(() => { petal.remove(); }, 12000);
            }
            setInterval(createPetal, 400);

            // --- 5. RSVP FORM HANDLER ---
            const rsvpForm = document.getElementById('rsvpForm');
            if (rsvpForm) {
                rsvpForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const name = document.getElementById('name').value;
                    alert('Thank you, ' + name + '! We have received your RSVP.');
                    rsvpForm.reset();
                });
            }
        });
    </script>
</body>
</html>
