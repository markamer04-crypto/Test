<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Wedding Day</title>

    <!-- Google Fonts & Swiper CSS -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        :root {
            --primary-gold: #d4af37;
            --soft-white: #fcfaf7;
            --text-dark: #2c2c2c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            font-family: 'Lato', sans-serif;
            color: var(--text-dark);
            background-color: var(--soft-white);
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        body.rope-locked {
            overflow: hidden !important;
        }

        /* --- FULLSCREEN ROPE OVERLAY COVER --- */
        #rope-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #111625;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease;
        }

        #rope-overlay.revealed {
            transform: translateY(-100vh);
            opacity: 0;
            pointer-events: none;
        }

        .rope-instruction {
            margin-top: 80px;
            color: #ffffff;
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            letter-spacing: 2px;
            text-align: center;
            pointer-events: none;
            text-shadow: 0 4px 10px rgba(0,0,0,0.5);
            animation: pulseText 2s infinite alternate;
        }

        @keyframes pulseText {
            0% { opacity: 0.6; transform: translateY(0); }
            100% { opacity: 1; transform: translateY(-5px); }
        }

        /* Pull Rope Canvas */
        #pull-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            cursor: grab;
            touch-action: none;
        }

        #pull-canvas:active {
            cursor: grabbing;
        }

        /* --- WEBSITE CONTENT STYLES --- */
        .hero {
            height: 100vh;
            width: 100%;
            background: linear-gradient(135deg, #0d0d1a 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            position: relative;
            padding: 0 20px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 8vw, 5rem);
            margin-bottom: 0.5rem;
            font-style: italic;
            letter-spacing: 3px;
        }

        .hero .subtitle {
            font-size: clamp(1rem, 3vw, 1.5rem);
            font-family: 'Playfair Display', serif;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        .hero p {
            font-size: clamp(0.8rem, 2vw, 1.1rem);
            letter-spacing: 4px;
            text-transform: uppercase;
            border-top: 1px solid rgba(212, 175, 55, 0.6);
            border-bottom: 1px solid rgba(212, 175, 55, 0.6);
            padding: 15px 25px;
        }

        #petal-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9998;
        }

        .petal {
            position: absolute;
            background-color: #ffe4e1;
            border-radius: 150% 0 150% 0;
            opacity: 0;
            animation: float 12s linear forwards;
        }

        @keyframes float {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.7; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }

        section {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 2.8rem);
            color: var(--primary-gold);
            margin-bottom: 40px;
            letter-spacing: 2px;
        }

        h2::after {
            content: '';
            display: block;
            width: 50px;
            height: 2px;
            background: var(--primary-gold);
            margin: 20px auto 0;
        }

        #countdown {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 30px;
        }

        .time-box {
            background: white;
            padding: 25px 15px;
            border-radius: 15px;
            min-width: 90px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

        .time-box span {
            display: block;
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: bold;
            color: var(--primary-gold);
        }

        .time-box p {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 5px;
            color: var(--text-dark);
        }

        #location-details {
            background-color: var(--soft-white);
            padding: 40px 20px;
        }

        .details-container {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            max-width: 1000px;
            margin: 0 auto;
        }

        .location-card-link {
            text-decoration: none;
            color: inherit;
            flex: 1;
            min-width: 280px;
            display: flex;
        }

        .location-card {
            width: 100%;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border-bottom: 4px solid var(--primary-gold);
            text-align: center;
        }

        .location-card .icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .location-card h3 {
            font-family: 'Playfair Display', serif;
            color: var(--primary-gold);
            margin-bottom: 10px;
            font-size: 1.6rem;
        }

        .map-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 8px 15px;
            background-color: var(--soft-white);
            color: var(--primary-gold);
            border: 1px solid var(--primary-gold);
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        #special-note {
            padding: 20px 0;
            display: flex;
            justify-content: center;
        }

        .mini-moment-container {
            width: 80%; 
            max-width: 350px; 
            margin: 0 auto;
        }

        .mini-moment-box img {
            width: 100%;
            aspect-ratio: 3 / 4; 
            object-fit: cover;
            border-radius: 12px 12px 0 0;
        }

        .mini-moment-label {
            padding: 15px;
            font-family: 'Playfair Display', serif;
            font-size: clamp(0.9rem, 2vw, 1.1rem); 
            color: var(--text-dark);
            background: white;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        #gallery {
            background: #f9f7f4;
            width: 100%;
        }

        .swiper-slide {
            width: 300px;
            height: 400px;
        }

        .swiper-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        .rsvp-form {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
            max-width: 550px;
            margin: 40px auto 0;
            border-top: 5px solid var(--primary-gold);
        }

        input, select {
            width: 100%;
            padding: 16px;
            margin: 12px 0;
            border: 1px solid #e1e1e1;
            border-radius: 8px;
            font-family: 'Lato', sans-serif;
            font-size: 1rem;
            outline: none;
        }

        button {
            width: 100%;
            padding: 18px;
            margin-top: 20px;
            background: var(--text-dark);
            color: white;
            border: none;
            border-radius: 8px;
            font-family: 'Lato', sans-serif;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
        }

        button:hover {
            background: var(--primary-gold);
        }

        footer {
            background: var(--text-dark);
            color: white;
            text-align: center;
            padding: 40px 20px;
        }
    </style>
</head>
<body class="rope-locked">

    <!-- OVERLAY WITH PULLABLE ROPE -->
    <div id="rope-overlay">
        <div class="rope-instruction">Pull the rope down to open ☟</div>
        <canvas id="pull-canvas"></canvas>
    </div>

    <!-- PETALS CONTAINER -->
    <div id="petal-container"></div>

    <!-- WEBSITE HERO SECTION -->
    <header class="hero">    
        <h1>Our Story</h1>
        <div class="subtitle">Join us in celebrating our journey</div>
        <p>Save the Date</p>
    </header>

    <!-- COUNTDOWN SECTION -->
    <section id="countdown-section">
        <h2>Days until the Wedding</h2>
        <div id="countdown">
            <div class="time-box"><span id="days">00</span><p>Days</p></div>
            <div class="time-box"><span id="hours">00</span><p>Hours</p></div>
            <div class="time-box"><span id="minutes">00</span><p>Mins</p></div>
            <div class="time-box"><span id="seconds">00</span><p>Secs</p></div>
        </div>
    </section>

    <!-- LOCATION SECTION -->
    <section id="location-details">
        <div class="details-container">
            <a href="https://maps.app.goo.gl/VaBfb3qn3Z6wrkBS7" target="_blank" class="location-card-link">
                <div class="location-card">
                    <div class="icon">⛪</div>
                    <h3>The Ceremony</h3>
                    <p>Saint Mina Church (Hanging Monastery)</p>
                    <p>El Quseyya, Assiut</p>
                    <p class="time">3:00 PM</p>
                    <span class="map-btn">View on Maps</span>
                </div>
            </a>
            
            <a href="https://maps.app.goo.gl/Wq6oMsXozDbCNyNX9" target="_blank" class="location-card-link">
                <div class="location-card">
                    <div class="icon">🏰</div>
