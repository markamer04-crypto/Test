    <!-- 9. FOOTER -->
    <footer>
        <p>Created with Love &copy; 2026</p>
    </footer>

    <!-- Swiper JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- ALL JAVASCRIPT LOGIC -->
    <script>
        window.addEventListener('load', () => {
            // --- 1. HEART ROPE PHYSICS LOGIC ---
            const canvas = document.getElementById('rope-canvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                const instruction = document.getElementById('rope-instruction');

                let width, height;
                let points = [];
                const numPoints = 80;
                let draggedPoint = null;
                let isRevealed = false;
                const pullThreshold = 200;

                function resizeCanvas() {
                    width = canvas.width = window.innerWidth || 800;
                    height = canvas.height = window.innerHeight || 600;
                    if (!isRevealed) {
                        initHeartRope();
                    }
                }

                function initHeartRope() {
                    points = [];
                    const centerX = width / 2;
                    const centerY = height / 2;
                    const scale = Math.min(width, height) / 32;

                    for (let i = 0; i < numPoints; i++) {
                        const t = (i / numPoints) * Math.PI * 2;
                        const x = 16 * Math.pow(Math.sin(t), 3);
                        const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));

                        const posX = centerX + x * scale;
                        const posY = centerY + y * scale;

                        points.push({
                            x: posX, y: posY,
                            ox: posX, oy: posY,
                            vx: 0, vy: 0
                        });
                    }
                }

                function getPointerPos(e) {
                    const rect = canvas.getBoundingClientRect();
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    return { x: clientX - rect.left, y: clientY - rect.top };
                }

                function onPointerDown(e) {
                    if (isRevealed) return;
                    const pos = getPointerPos(e);
                    let minDist = Infinity;

                    points.forEach(p => {
                        const dist = Math.hypot(p.x - pos.x, p.y - pos.y);
                        if (dist < minDist) {
                            minDist = dist;
                            draggedPoint = p;
                        }
                    });

                    if (minDist > 80) draggedPoint = null;
                }

                function onPointerMove(e) {
                    if (!draggedPoint || isRevealed) return;
                    const pos = getPointerPos(e);
                    draggedPoint.x = pos.x;
                    draggedPoint.y = pos.y;

                    const dist = Math.hypot(draggedPoint.x - draggedPoint.ox, draggedPoint.y - draggedPoint.oy);
                    if (dist > pullThreshold) revealWebsite();
                }

                function onPointerUp() { draggedPoint = null; }

                function updateRopePhysics() {
                    if (isRevealed) return;
                    const stiffness = 0.08;
                    const damping = 0.82;

                    for (let i = 0; i < points.length; i++) {
                        const p = points[i];
                        if (p !== draggedPoint) {
                            p.vx = (p.vx + (p.ox - p.x) * stiffness) * damping;
                            p.vy = (p.vy + (p.oy - p.y) * stiffness) * damping;
                            p.x += p.vx;
                            p.y += p.vy;
                        }
                    }
                }

                function drawRope() {
                    ctx.clearRect(0, 0, width, height);
                    if (isRevealed || points.length === 0) return;

                    ctx.beginPath();
                    ctx.moveTo(points[0].x, points[0].y);
                    for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
                    ctx.closePath();
                    
                    ctx.lineWidth = 22;
                    ctx.strokeStyle = '#d4af37'; // Matching Gold Accent
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';
                    ctx.stroke();

                    ctx.lineWidth = 6;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();
                }

                function animate() {
                    updateRopePhysics();
                    drawRope();
                    requestAnimationFrame(animate);
                }

                function revealWebsite() {
                    isRevealed = true;
                    canvas.classList.add('hidden');
                    if (instruction) instruction.style.opacity = '0';
                    document.body.classList.remove('rope-locked');
                }

                window.addEventListener('resize', resizeCanvas);
                canvas.addEventListener('mousedown', onPointerDown);
                window.addEventListener('mousemove', onPointerMove);
                window.addEventListener('mouseup', onPointerUp);

                canvas.addEventListener('touchstart', onPointerDown);
                window.addEventListener('touchmove', onPointerMove);
                window.addEventListener('touchend', onPointerUp);

                resizeCanvas();
                animate();
            }

            // --- 2. COUNTDOWN LOGIC ---
            const weddingDate = new Date("April 16, 2026 15:00:00").getTime();
            const timer = setInterval(function() {
                const now = new Date().getTime();
                const distance = weddingDate - now;

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                if (document.getElementById("days")) {
                    document.getElementById("days").innerText = days.toString().padStart(2, '0');
                    document.getElementById("hours").innerText = hours.toString().padStart(2, '0');
                    document.getElementById("minutes").innerText = minutes.toString().padStart(2, '0');
                    document.getElementById("seconds").innerText = seconds.toString().padStart(2, '0');
                }

                if (distance < 0) {
                    clearInterval(timer);
                    document.getElementById("countdown").innerHTML = "<h3>The Celebration has Begun!</h3>";
                }
            }, 1000);

            // --- 3. SWIPER SLIDER LOGIC ---
            const swiper = new Swiper('.swiper', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 50,
                    stretch: 0,
                    depth: 100,
                    modifier: 1,
                    slideShadows: true,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
            });

            // --- 4. FLOATING PETALS LOGIC ---
            function createPetal() {
                const container = document.getElementById('petal-container');
                if(!container) return;
                const petal = document.createElement('div');
                petal.className = 'petal';
                petal.style.left = Math.random() * 100 + 'vw';
                petal.style.width = Math.random() * 15 + 10 + 'px';
                petal.style.height = petal.style.width;
                petal.style.animationDuration = Math.random() * 5 + 7 + 's';
                container.appendChild(petal);
                setTimeout(() => { petal.remove(); }, 12000);
            }
            setInterval(createPetal, 400);

            // --- 5. RSVP FORM HANDLER ---
            const rsvpForm = document.getElementById('rsvpForm');
            if (rsvpForm) {
                rsvpForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const name = document.getElementById('name').value;
                    alert('Thank you, ' + name + '! We have received your RSVP.');
                    rsvpForm.reset();
                });
            }
        });
    </script>
</body>
</html>
